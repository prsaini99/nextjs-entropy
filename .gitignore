# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
config.bat
.env.vercel

# Google service-account keys (GA4 Data API). Never commit these.
ga-service-account.json
*-service-account.json
*.serviceaccount.json
# GCP downloads keys as <project-id>-<hash>.json
lexical-cider-*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Marketing loop snapshots. Contains lead PII (names, emails, phone numbers)
# pulled from Supabase, plus daily GA4/Clarity captures. Local only by decision —
# see marketing/DESIGN.md §8. Generated documents from the same folder too.
marketing/data/
marketing/joined/
docs/ads/StackBinary-*.doc
docs/ads/StackBinary-*.rtf

# OAuth client secrets (Google Ads API). GCP names the download
# client_secret_<id>.apps.googleusercontent.com.json — which matched none of
# the patterns above, so it landed in the repo untracked and visible to git.
client_secret_*.json
*.apps.googleusercontent.com.json
google-ads.yaml
